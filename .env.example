
# API key for IGNAV
IGNAV_API_KEY=
DOSSIER_JSON=/app/service_externe/api/data/raw
# Backend configuration
ENV=production

# Database configuration
POSTGRES_HOST=localhost
POSTGRES_NAME=sae
POSTGRES_USER=sae_user
POSTGRES_PASSWORD=remplace-par-un-mot-de-passe
POSTGRES_PORT=5432
BACKEND_PORT=8000
DATABASE_URL=postgresql://sae:motdepasse@localhost:5433/sae

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
SMTP_FROM_NAME=
SMTP_TIMEOUT=10

# Temps de validité
JETON_ACTIVATION_HEURES=24
JETON_REINITIALISATION_HEURES=1
# Contact Equipes : formulaire public, sans compte
CONTACT_EMAIL_EQUIPE=

# Security configuration
JWT_SECRET=
totp_encryption_key==
    

# Frontend configuration
FRONTEND_URL=http://localhost:5173
